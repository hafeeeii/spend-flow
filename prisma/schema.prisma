// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum MemberRole {
  ADMIN
  MANAGER
  EMPLOYEE
  CFO
}

enum MembershipStatus {
  ACTIVE
  INVITED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorRisk {
  LOW
  MEDIUM
  HIGH
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  APPROVAL
  ALERT
  REJECTED
  INFO
}

// --- MODELS ---
model Organization {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships Membership[]
  departments Department[]
  vendors     Vendor[]
  budgets     Budget[]
  requests    PurchaseRequest[]
  workflows   Workflow[]
  auditLogs   AuditLog[]
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String
  avatar           String?
  memberships      Membership[]
  comments         Comment[]
  notifications    Notification[]
  assignedTasks    ApprovalTask[]    @relation("assignedTasks")
  auditLogs        AuditLog[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchaseRequests PurchaseRequest[]
}

model Membership {
  id             String           @id @default(uuid())
  role           MemberRole
  status         MembershipStatus @default(INVITED)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, organizationId])
}

model Department {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  budgets        Budget[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
}

model Vendor {
  id              String            @id @default(uuid())
  name            String
  category        String
  activeContracts Int               @default(0)
  annualSpend     Decimal           @default(0)
  risk            VendorRisk        @default(LOW)
  logo            String?
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests        PurchaseRequest[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([organizationId, name])
}

model Budget {
  id             String            @id @default(uuid())
  departmentId   String
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  category       String
  limit          Decimal
  spent          Decimal           @default(0)
  color          String            @default("#635bff")
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests       PurchaseRequest[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, departmentId, category])
}

model PurchaseRequest {
  id             String         @id @default(uuid())
  requestNumber  Int            @unique @default(autoincrement()) // Generates SF-XXXX sequentials
  title          String
  description    String
  requesterId    String
  requester      User           @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  vendorId       String?
  vendorName     String // Direct vendor name
  vendor         Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  category       String
  amount         Decimal
  currency       String         @default("USD")
  budgetCategory String
  budgetId       String?
  budget         Budget?        @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  status         RequestStatus  @default(PENDING)
  currentStage   String // e.g. "Manager Approval", "CFO Approval"
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attachments    Attachment[]
  comments       Comment[]
  approvalTasks  ApprovalTask[]
  auditLogs      AuditLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Attachment {
  id        String          @id @default(uuid())
  name      String
  size      String // e.g. "142 KB"
  type      String // e.g. "pdf", "image"
  url       String?
  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
}

model Comment {
  id        String          @id @default(uuid())
  text      String
  authorId  String
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
}

model ApprovalTask {
  id           String          @id @default(uuid())
  requestId    String
  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepId       String?
  step         WorkflowStep?   @relation(fields: [stepId], references: [id], onDelete: SetNull)
  assignedRole MemberRole?
  assignedToId String?
  assignedTo   User?           @relation("assignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  status       ApprovalStatus  @default(PENDING)
  comment      String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Workflow {
  id             String         @id @default(uuid())
  name           String
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules          WorkflowRule[]
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model WorkflowRule {
  id         String         @id @default(uuid())
  workflowId String
  workflow   Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  minAmount  Decimal
  maxAmount  Decimal?
  steps      WorkflowStep[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model WorkflowStep {
  id        String         @id @default(uuid())
  ruleId    String
  rule      WorkflowRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  role      MemberRole
  sequence  Int
  tasks     ApprovalTask[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([ruleId, sequence])
}

model AuditLog {
  id             String           @id @default(uuid())
  displayId      String? // e.g. "LOG-091"
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorName      String
  actorRole      String
  action         String
  target         String
  changesBefore  String?
  changesAfter   String?
  requestId      String?
  request        PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  timestamp      DateTime         @default(now())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String           @id @default(uuid())
  title       String
  description String
  type        NotificationType
  unread      Boolean          @default(true)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId   String?
  timestamp   DateTime         @default(now())
}
